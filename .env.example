PORT=6000
NODE_ENV=production
APP_BASE_URL=https://email-marketing-a63n.onrender.com
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=your-mongodb-atlas-connection-string

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Amazon SES (AWS SDK v3 uses the standard AWS credential provider chain)
AWS_REGION=eu-north-1
# On Render, prefer an attached IAM role where supported. Otherwise set:
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
SES_CONFIGURATION_SET=email-marketing-events
EMAIL_FROM=info@your-verified-domain.com
SES_API_TIMEOUT_MS=20000

# Optional defaults shown in the dashboard
EMAIL_FROM_NAME=Your Company
EMAIL_REPLY_TO=replies@your-domain.com

# Campaign settings
EMAIL_DELAY_MS=5000
MAX_RECIPIENTS_PER_CAMPAIGN=5000
MAX_LEADS_FILE_BYTES=1048576

# Amazon SNS webhook topic ARN. Restricts accepted SNS notifications to this topic.
SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:123456789012:email-marketing-events
