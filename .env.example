PORT=6000
NODE_ENV=development
APP_BASE_URL=http://localhost:6000
SESSION_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/email_marketing

# Create the first admin on first startup. Change these values before running.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToALongUniquePassword123!

# SMTP sender. SMTP_FROM must be an address you are authorized to send from.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=you@example.com

# Campaign settings
EMAIL_DELAY_MS=10000
MAX_RECIPIENTS_PER_CAMPAIGN=5000
MAX_LEADS_FILE_BYTES=1048576
