{
  "name": "email-marketing-app",
  "version": "2.0.0",
  "private": true,
  "description": "Email campaign manager with a Vite + React frontend and Express + MongoDB backend using the Brevo email API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon --exec \"node --use-system-ca\" server.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node --use-system-ca server.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "mongoose": "^8.24.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "vite": "^6.3.5"
  }
}
